<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Ovoz" parent="Theme.AppCompat.DayNight.NoActionBar" />

    <style name="Theme.Ovoz.Dialog" parent="Theme.AppCompat.DayNight.Dialog">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
    </style>

    <style name="Widget.Ovoz.Button" parent="Widget.AppCompat.Button">
        <item name="android:minHeight">84dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:layout_marginTop">12dp</item>
    </style>

    <style name="Text.Ovoz">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:accessibilityLiveRegion">polite</item>
    </style>

    <style name="Text.Ovoz.Title">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:accessibilityLiveRegion">none</item>
    </style>
</resources>
